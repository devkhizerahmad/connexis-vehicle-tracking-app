{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@features/*": ["./src/features/*"],
      "@navigation/*": ["./src/navigation/*"]
    }
  },
  "exclude": ["node_modules", "snapshot-pre-refactor", "ui-baseline", "ui-after"],
  "include": ["**/*.ts", "**/*.tsx"]
}